# Starts immediately with the versioned, cited hand dataset. No database required.
ANATOMY_DATA_MODE=bundled

# Optional local Neo4j. Copy this file to .env.local, uncomment the connection
# settings and set a unique local password (at least 8 characters).
# docker compose --env-file .env.local up -d
# npm run seed
# Switch ANATOMY_DATA_MODE above to neo4j, then restart Next.js.
# NEO4J_URI=bolt://127.0.0.1:17687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=replace-with-your-local-password
# NEO4J_DATABASE=neo4j
